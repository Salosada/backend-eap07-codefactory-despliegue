# Copiar a .env para despliegue local o configurar en Render Dashboard

SPRING_PROFILES_ACTIVE=prod
PORT=8080

# TiDB Cloud (MySQL compatible)
SPRING_DATASOURCE_URL=jdbc:mysql://HOST:4000/appstripe?useSSL=true&requireSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=your_tidb_user
SPRING_DATASOURCE_PASSWORD=your_tidb_password

# JWT — generar un valor seguro en producción
JWT_SECRET=change-me-to-a-long-random-string

# Orígenes permitidos (Vercel). Usa el dominio de producción y/o wildcard de previews:
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://*.vercel.app,http://localhost:3000

# Desactivar Docker Compose en cloud
SPRING_DOCKER_COMPOSE_ENABLED=false
SPRING_JPA_HIBERNATE_DDL_AUTO=update
